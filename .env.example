# Optional path to hackathon secrets file (defaults to ~/.config/hackathon/secrets.env)
PATCHBAY_SECRETS_FILE=
# Nebius Token Factory API key for Nemotron inference
NEBIUS_API_KEY=
# Tavily API key for vulnerability research
TAVILY_API_KEY=
# Primary Nemotron model on Nebius Token Factory (default: nvidia/nemotron-3-super-120b-a12b)
NEMOTRON_MODEL=
# Fallback Nemotron model on Nebius Token Factory (default: nvidia/Nemotron-3-Ultra-550b-a55b)
NEMOTRON_FALLBACK_MODEL=
# Nebius Token Factory OpenAI-compatible API base URL
NEBIUS_BASE_URL=
# Live mode toggle: 1 for live API calls, 0 to replay recorded fixtures
LIVE=0
# Directory containing recorded fixtures for offline replay (default: fixtures)
FIXTURES_DIR=
# Completion budget for Nemotron, reasoning tokens included (default: 32768)
NEMOTRON_MAX_TOKENS=
